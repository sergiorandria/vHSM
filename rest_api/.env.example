# vHSM Go API — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# The API loads .env automatically (see cmd/api/main.go loadDotEnv).

# ── MinIO object storage ───────────────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=thesis

# ── PKCS#11 HSM module ────────────────────────────────────────────────
# Path to the PKCS#11 shared library. Two backends are supported — select
# one by pointing HSM_MODULE_PATH at its .so:
#   • SoftHSM2 (dev / tests):        /usr/lib/softhsm/libsofthsm2.so
#   • vHSM C++ module (production):  <build>/src/pkcs11/libvhsm_pkcs11.so
# The module must expose a token labelled HSM_TOKEN_LABEL (below) that
# contains the AES key (HSM_LABEL) and the signing key (HSM_SIGN_LABEL).
HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_TOKEN_LABEL=vhsm-token
HSM_PIN=CHANGE_ME
HSM_LABEL=vhsm-aes-key
HSM_SIGN_LABEL=vhsm-sign-key

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=60

# ── LDAP ───────────────────────────────────────────────────────────────
LDAP_URL=ldap://localhost:1389
LDAP_BIND_DN=cn=admin,dc=misa,dc=university,dc=com
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_USER_BASE_DN=ou=users,dc=misa,dc=university,dc=com
LDAP_USER_FILTER=(uid=%s)
LDAP_GROUP_BASE_DN=ou=groups,dc=misa,dc=university,dc=com
LDAP_GROUP_FILTER=(member=%s)
LDAP_ROLE_ATTR=cn
LDAP_USE_TLS=false
LDAP_INSECURE_SKIP_VERIFY=false

# ── Fabric gateway (env overrides /etc/vhsmd/default-fabric.conf) ───────
MSP_ID=MisaMSP
CHANNEL_NAME=canaltest
CHAINCODE_NAME=template_chaincode
CRYPTO_PATH=../network/fabric_configuration/Conf_with_fabric-CA/organizations
CERT_PATH=${CRYPTO_PATH}/peerOrganizations/misa.university.com/users/User1@misa.university.com/msp/signcerts/User1@misa.university.com-cert.pem
KEY_PATH=${CRYPTO_PATH}/peerOrganizations/misa.university.com/users/User1@misa.university.com/msp/keystore
TLS_CERT_PATH=${CRYPTO_PATH}/peerOrganizations/misa.university.com/peers/peer0.misa.university.com/tls/ca.crt
PEER_ENDPOINT=127.0.0.1:7051
GATEWAY_PEER_NAME=peer0.misa.university.com

# ── HTTP server ────────────────────────────────────────────────────────
PORT=8080
