# Real-network variables (TEMPLATE). Copy to .env and fill in real values.
# .env is gitignored (*.env); this file is committable.

# --- Org1 (this host) ---
ORG1_DOMAIN="org1.example.com"
ORG1_DOMAIN_DOMAIN_PART="org1"
ORG1_DOMAIN_TLD_PART="example"
ORG1_DB_NAME="fabric_ca_org1"
ORG1_DB_USER="fabricca"
ORG1_DB_PASS="CHANGE_ME"
ORG1_LDAP_ADMIN_PASS="CHANGE_ME"
# Public DNS / IP that OTHER hosts and vHSM clients use to reach this peer.
# MUST also be a SAN in this peer's TLS certificate.
ORG1_PUBLIC_HOST="org1.example.com"
ORG1_PEER_EXTERNAL_PORT=7051
ORG1_CHAINCODE_EXTERNAL_PORT=7052

# Host directory where THIS host's generated crypto lives (absolute path).
ORG1_CRYPTO_ROOT="/etc/vhsmd/organizations"
# Host directory where channel artifacts (genesis block, *.tx) are placed.
ORG1_CHANNEL_ARTIFACTS="/etc/vhsmd/channel-artifacts"

# --- Orderer (remote host; only the public address + TLS CA are needed here) ---
ORD_ORG_DOMAIN="university.com"

# --- vHSM client wiring (mirrors VHSM_LEDGER_* env in the C++/Go clients) ---
# Endpoint the LedgerClient connects to (internet-reachable gateway address):
VHSM_LEDGER_ENDPOINT="org1.example.com:7051"
VHSM_LEDGER_MSP_ID="Org1MSP"
# Paths to THIS org's TLS client identity + the orderer/ca TLS root:
VHSM_LEDGER_CERT="/etc/vhsmd/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/tls/client.crt"
VHSM_LEDGER_KEY="/etc/vhsmd/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/tls/client.key"
VHSM_LEDGER_CA="/etc/vhsmd/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt"
VHSM_LEDGER_SERVER_NAME="peer0.org1.example.com"
