// vHSM dependency graph (Graphviz). Render:
//   dot -Tsvg docs/dependency_graph.dot -o dependency_graph.svg
digraph vhsm {
  rankdir=TB;
  node [shape=box, style=rounded];

  // --- internal C++ libraries ---
  vhsm_core [label="vhsm_core"];
  vhsm_log [label="vhsm_log"];
  vhsm_threadpool [label="vhsm_threadpool"];
  vhsm_notification [label="vhsm_notification"];
  vhsm_crypto_provider [label="vhsm_crypto_provider\nsubmodule: vhsm-secure-crypto"];
  vhsm_crypto [label="vhsm_crypto"];
  vhsm_keystore [label="vhsm_keystore"];
  vhsm_session [label="vhsm_session"];
  vhsm_persistence [label="vhsm_persistence"];
  vhsm_signature_store [label="vhsm_signature_store\n(embeds audit_log.cpp)"];
  vhsm_ledger [label="vhsm_ledger", style="rounded,dashed"];
  vhsm_admin [label="vhsm_admin (gRPC)"];
  vhsm_pkcs11 [label="vhsm_pkcs11 / .so module"];

  // --- external / system ---
  OpenSSL [label="OpenSSL"];
  SQLite3 [label="SQLite3"];
  gRPC [label="gRPC + protobuf"];
  nlohmann_json [label="nlohmann_json"];
  fabric_gateway_cpp [label="fabric-gateway-cpp\nsubmodule"];

  // --- consumers ---
  rest_api [label="Go REST API", shape=ellipse];
  examples [label="examples ex01..ex06", shape=ellipse];
  bench [label="vhsm_bench", shape=ellipse];
  chaincode [label="signature_ledger chaincode (Go)", shape=ellipse];
  fabric [label="Hyperledger Fabric", shape=ellipse];

  vhsm_log -> vhsm_core;
  vhsm_threadpool -> vhsm_log;
  vhsm_notification -> vhsm_core;
  vhsm_crypto -> vhsm_crypto_provider;
  vhsm_keystore -> vhsm_core;
  vhsm_keystore -> vhsm_crypto_provider;
  vhsm_session -> vhsm_core;
  vhsm_session -> vhsm_crypto_provider;
  vhsm_persistence -> vhsm_core;
  vhsm_persistence -> vhsm_crypto;
  vhsm_persistence -> vhsm_keystore;
  vhsm_persistence -> vhsm_crypto_provider;
  vhsm_signature_store -> vhsm_core;
  vhsm_signature_store -> vhsm_crypto;
  vhsm_signature_store -> vhsm_keystore;
  vhsm_signature_store -> vhsm_persistence;
  vhsm_signature_store -> vhsm_notification;
  vhsm_signature_store -> vhsm_crypto_provider;
  vhsm_ledger -> fabric_gateway_cpp [style=dashed, label="VHSM_LEDGER"];
  vhsm_signature_store -> vhsm_ledger [style=dashed, label="VHSM_LEDGER"];
  vhsm_admin -> vhsm_core;
  vhsm_admin -> vhsm_keystore;
  vhsm_admin -> vhsm_persistence;
  vhsm_admin -> vhsm_session;
  vhsm_admin -> vhsm_notification;
  vhsm_admin -> vhsm_signature_store;
  vhsm_admin -> gRPC;
  vhsm_pkcs11 -> vhsm_core;
  vhsm_pkcs11 -> vhsm_log;
  vhsm_pkcs11 -> vhsm_crypto;
  vhsm_pkcs11 -> vhsm_keystore;
  vhsm_pkcs11 -> vhsm_persistence;
  vhsm_pkcs11 -> vhsm_session;
  vhsm_pkcs11 -> vhsm_signature_store;
  vhsm_pkcs11 -> vhsm_notification;
  vhsm_pkcs11 -> vhsm_threadpool;
  vhsm_pkcs11 -> vhsm_crypto_provider;
  vhsm_pkcs11 -> vhsm_ledger [style=dashed, label="VHSM_LEDGER"];
  vhsm_pkcs11 -> SQLite3;
  vhsm_pkcs11 -> nlohmann_json;

  vhsm_crypto_provider -> OpenSSL;
  fabric_gateway_cpp -> gRPC;
  fabric_gateway_cpp -> OpenSSL;

  rest_api -> vhsm_pkcs11 [label="loads .so"];
  examples -> vhsm_pkcs11;
  bench -> vhsm_pkcs11;
  vhsm_admin -> vhsm_pkcs11;
  vhsm_pkcs11 -> chaincode [label="anchors"];
  rest_api -> chaincode [label="invokes"];
  chaincode -> fabric;
}
